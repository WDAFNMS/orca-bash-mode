{
  "manifestVersion": 2,
  "id": "bash-mode",
  "name": "Bash Mode",
  "version": "0.2.0",
  "description": "A bash mode for the structured chat box: turn it on, type a command, and it is sent as `!command`. Checks for, installs and uninstalls the claude-bang-shell plugin that runs it.",
  "license": "MIT",
  "repository": "https://github.com/WDAFNMS/orca-bash-mode",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "commands": [
      {
        "id": "bash-mode.inject",
        "title": "Bash Mode: inject into the chat page"
      },
      {
        "id": "bash-mode.remove",
        "title": "Bash Mode: remove from the chat page"
      },
      {
        "id": "bash-mode.install-claude-plugin",
        "title": "Bash Mode: install the Claude plugin (bang-shell)"
      },
      {
        "id": "bash-mode.uninstall",
        "title": "Bash Mode: uninstall everything"
      }
    ],
    "statusBarItems": [
      {
        "id": "status",
        "text": "bash …",
        "tooltip": "Bash Mode",
        "command": "bash-mode.inject"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}
